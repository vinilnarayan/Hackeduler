# Copy to .env and fill in. NEVER commit .env.
# ---- Database (docker compose)
POSTGRES_DB=orp
POSTGRES_USER=orp
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Application
ORP_ENVIRONMENT=development           # production enforces strong secret + secure cookies
ORP_SECRET_KEY=change-me-to-a-random-64-char-string   # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ORP_COOKIE_SECURE=false               # MUST be true in production (HTTPS)
ORP_SESSION_HOURS=8
ORP_APP_BASE_URL=http://localhost:8080
ORP_SEED=demo                         # demo | minimal | none  (use none/minimal in production)
ORP_RATE_LIMIT_PER_MINUTE=600
ORP_LOGIN_RATE_LIMIT_PER_MINUTE=10
ORP_WEB_WORKERS=2

# ---- Single sign-on (providers, client secrets and policy are configured in Admin -> Single Sign-On)
ORP_ENCRYPTION_KEY=change-me-separate-random-key   # encrypts SSO client secrets in the DB; keep stable & backed up
ORP_FORCE_LOCAL_LOGIN=false           # BREAK-GLASS: true re-enables password sign-in if an SSO misconfiguration locks you out
ORP_SSO_HTTP_TIMEOUT=10

# ---- Email (secrets live ONLY here, never in the database or UI)
ORP_EMAIL_BACKEND=smtp                # smtp | console (log only) | memory (tests)
ORP_SMTP_HOST=mailpit                 # docker compose --profile dev starts Mailpit
ORP_SMTP_PORT=1025
ORP_SMTP_USERNAME=
ORP_SMTP_PASSWORD=
ORP_SMTP_STARTTLS=false
ORP_SMTP_SSL=false
ORP_WORKER_INTERVAL_SECONDS=30

# Copy to .env and fill in. NEVER commit .env.
# ---- Database (docker compose)
POSTGRES_DB=hackeduler
POSTGRES_USER=hackeduler
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Application
HACKEDULER_ENVIRONMENT=development           # production enforces strong secret + secure cookies
HACKEDULER_SECRET_KEY=change-me-to-a-random-64-char-string   # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
HACKEDULER_COOKIE_SECURE=false               # MUST be true in production (HTTPS)
HACKEDULER_SESSION_HOURS=8
HACKEDULER_APP_BASE_URL=http://localhost:8080
HACKEDULER_SEED=demo                         # demo | minimal | none  (use none/minimal in production)
HACKEDULER_RATE_LIMIT_PER_MINUTE=600
HACKEDULER_LOGIN_RATE_LIMIT_PER_MINUTE=10
HACKEDULER_WEB_WORKERS=2

# ---- Single sign-on (providers, client secrets and policy are configured in Admin -> Single Sign-On)
HACKEDULER_ENCRYPTION_KEY=change-me-separate-random-key   # encrypts SSO client secrets in the DB; keep stable & backed up
HACKEDULER_FORCE_LOCAL_LOGIN=false           # BREAK-GLASS: true re-enables password sign-in if an SSO misconfiguration locks you out
HACKEDULER_SSO_HTTP_TIMEOUT=10

# ---- Email (secrets live ONLY here, never in the database or UI)
HACKEDULER_EMAIL_BACKEND=smtp                # smtp | console (log only) | memory (tests)
HACKEDULER_SMTP_HOST=mailpit                 # docker compose --profile dev starts Mailpit
HACKEDULER_SMTP_PORT=1025
HACKEDULER_SMTP_USERNAME=
HACKEDULER_SMTP_PASSWORD=
HACKEDULER_SMTP_STARTTLS=false
HACKEDULER_SMTP_SSL=false
HACKEDULER_WORKER_INTERVAL_SECONDS=30

# Copy to .env and fill in (./deploy.sh does this for you on first run). NEVER commit .env.
# AWS deployment: app on EC2, database on Amazon RDS (PostgreSQL 16), email through Amazon SES and/or SMTP.

# ---- Database: Amazon RDS (there is no database container in this deployment)
# RDS endpoint, e.g. hackeduler.abc123xyz.ap-south-1.rds.amazonaws.com
HACKEDULER_DB_HOST=
HACKEDULER_DB_PORT=5432
HACKEDULER_DB_NAME=hackeduler
HACKEDULER_DB_USER=hackeduler                # must OWN the database: migrations create and alter tables
# Keep the single quotes around the password: any characters work (no URL-encoding needed) except a single quote itself.
HACKEDULER_DB_PASSWORD=''
HACKEDULER_DB_SSLMODE=verify-full            # verify-full (recommended) | verify-ca | require. RDS enforces TLS.
HACKEDULER_DB_SSLROOTCERT=/certs/rds-global-bundle.pem   # downloaded into ./certs by ./deploy.sh
HACKEDULER_DB_POOL_SIZE=5                    # per web worker; (workers x (pool+overflow)) + worker must stay
HACKEDULER_DB_MAX_OVERFLOW=5                 # below the RDS max_connections of your instance class

# ---- Application
HACKEDULER_ENVIRONMENT=production            # production enforces strong secret + secure cookies
HACKEDULER_SECRET_KEY=change-me-to-a-random-64-char-string   # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
HACKEDULER_COOKIE_SECURE=true                # MUST be true in production (HTTPS)
HACKEDULER_SESSION_HOURS=8
HACKEDULER_APP_BASE_URL=http://localhost:7080   # maintained by deploy.sh from the port / domain below

# ---- Network. This host is shared with other apps (e.g. SPARK), so Hackeduler uses its own ports.
# Easiest: ./deploy.sh --port / --domain / --https (see docs/AWS.md and docs/NETWORK.md)
HACKEDULER_HTTP_PORT=7080             # host port the app is served on - an AWS load balancer target or a host proxy upstream
HACKEDULER_BIND_ADDRESS=0.0.0.0       # 127.0.0.1 = only reachable through a reverse proxy on this server
# DNS name that points to this app, e.g. hackeduler.example.com
HACKEDULER_DOMAIN=
# Address users open when TLS is handled OUTSIDE this stack (AWS load balancer / host proxy), e.g. https://hackeduler.example.com
HACKEDULER_PUBLIC_URL=
HACKEDULER_HTTPS=off                  # off (TLS handled by an AWS load balancer / host proxy) | files | auto | internal
HACKEDULER_HTTPS_PORT=7443            # used when HACKEDULER_HTTPS is not off
HACKEDULER_HTTP_REDIRECT_PORT=7081    # plain-HTTP port that redirects to HTTPS
# required for HACKEDULER_HTTPS=auto
HACKEDULER_ACME_EMAIL=
HACKEDULER_SEED=minimal                      # demo | minimal | none  (use none after the first start in production)
HACKEDULER_RATE_LIMIT_PER_MINUTE=600
HACKEDULER_LOGIN_RATE_LIMIT_PER_MINUTE=10
HACKEDULER_WEB_WORKERS=2

# Resource limits for this stack (the machine is shared). Raise them if the app is busy.
HACKEDULER_BACKEND_MEM=1g
HACKEDULER_BACKEND_CPUS=1.5
HACKEDULER_WORKER_MEM=512m
HACKEDULER_WORKER_CPUS=0.5

# ---- Single sign-on (providers, client secrets and policy are configured in Admin -> Single Sign-On)
HACKEDULER_ENCRYPTION_KEY=change-me-separate-random-key   # encrypts SSO client secrets in the DB; keep stable & backed up
HACKEDULER_FORCE_LOCAL_LOGIN=false           # BREAK-GLASS: true re-enables password sign-in if an SSO misconfiguration locks you out
HACKEDULER_SSO_HTTP_TIMEOUT=10

# ---- Email. Admin -> Settings can override the service, region and SMTP host; secrets live ONLY here.
HACKEDULER_EMAIL_BACKEND=smtp                # smtp = real delivery (SES and/or SMTP) | console (log only) | memory (tests)
HACKEDULER_EMAIL_PRIMARY=ses                 # service tried first: ses | smtp
HACKEDULER_EMAIL_FALLBACK=none               # tried if the first fails: smtp | ses | none
# Amazon SES (API). Credentials come from the EC2 instance role - nothing secret goes here.
# e.g. ap-south-1 (the region where your SES sender identity is verified)
HACKEDULER_AWS_REGION=
# optional SES configuration set
HACKEDULER_SES_CONFIGURATION_SET=
# SMTP server (corporate relay, or the SES SMTP endpoint)
HACKEDULER_SMTP_HOST=
HACKEDULER_SMTP_PORT=587
HACKEDULER_SMTP_USERNAME=
HACKEDULER_SMTP_PASSWORD=
HACKEDULER_SMTP_STARTTLS=true
HACKEDULER_SMTP_SSL=false
HACKEDULER_WORKER_INTERVAL_SECONDS=30
